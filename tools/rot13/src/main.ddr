import std.parse as parse
import std.text as text
import sys

import rot13

fn usage() -> i32 {
    _ := sys.eprint("usage: rot13 [-n N] [FILE]")
    _ := sys.eprint("  -n N   rotate ASCII letters by N positions (default 13)")
    _ := sys.eprint("  reads stdin when FILE is omitted or is '-'")
    return 2
}

fn strip_one_newline(s: string) -> string {
    if text.ends_with(s, "\n") { return s[0..s.len - 1] }
    s.clone()
}

fn main() -> i32 {
    count := sys.arg_count()
    mut shift := 13
    mut path := ""
    mut i := 1
    while i < count {
        a := sys.arg(i)
        if a == "-n" {
            if i + 1 >= count { _ := sys.eprint("rot13: missing value after -n"); return 2 }
            i += 1
            n := parse.integer(sys.arg(i))
            if !n.ok || n.value < -1000000 || n.value > 1000000 {
                _ := sys.eprint("rot13: -n must be an integer in -1000000..1000000")
                return 2
            }
            shift = i32(n.value)
        } else if text.starts_with(a, "-") && a.len > 1 {
            _ := sys.eprint("rot13: unknown flag " + a)
            return 2
        } else if path.len > 0 {
            _ := sys.eprint("rot13: only one input file allowed")
            return 2
        } else {
            path = a
        }
        i += 1
    }

    mut source := ""
    if path.len == 0 || path == "-" {
        data := sys.read_text("/dev/stdin")
        if !data.ok { _ := sys.eprint("rot13: cannot read stdin: " + sys.error_message(data.error)); return 1 }
        source = data.value
    } else {
        data := sys.read_text(path)
        if !data.ok { _ := sys.eprint("rot13: cannot read " + path + ": " + sys.error_message(data.error)); return 1 }
        source = data.value
    }
    print(rot13.rotate(strip_one_newline(source), shift))
    return 0
}
