import std.text as text
import sys

import csv2json

fn usage() -> i32 {
    _ := sys.eprint("usage: csv2json [--header H1,H2,...] [FILE]")
    _ := sys.eprint("  CSV -> JSON array of objects; the first data row is the header unless --header is given")
    _ := sys.eprint("  quoted cells may contain commas, doubled quotes and newlines; reads stdin when FILE is omitted or '-'")
    return 2
}

fn split_header(spec: string) -> Result<[]string, string> {
    mut names: []string = []
    parts := text.split(spec, ",")
    for part in parts {
        if text.trim(part).len == 0 { return .Err("header names must be non-empty") }
        names.push(part.clone())
    }
    .Ok(names)
}

fn main() -> i32 {
    mut header_spec := ""
    mut positional: []string = []
    count := sys.arg_count()
    mut i := 1
    while i < count {
        a := sys.arg(i)
        if a == "--header" {
            if i + 1 >= count { _ := sys.eprint("csv2json: missing value after --header"); return 2 }
            i += 1
            header_spec = sys.arg(i)
        } else if text.starts_with(a, "--") && a.len > 2 {
            _ := sys.eprint("csv2json: unknown flag " + a)
            return 2
        } else {
            positional.push(a.clone())
        }
        i += 1
    }
    if positional.len > 1 { return usage() }

    mut read_path := "/dev/stdin"
    if positional.len == 1 && positional[0] != "-" { read_path = positional[0].clone() }
    content := sys.read_text(read_path)
    if !content.ok {
        _ := sys.eprint("csv2json: cannot read " + read_path + ": " + sys.error_message(content.error))
        return 1
    }
    mut payload := content.value
    match csv2json.parse_csv(payload) {
        .Ok(rows) => {
            mut header: []string = []
            mut data: [][]string = []
            if header_spec.len > 0 {
                match split_header(header_spec) {
                    .Ok(names) => { header = names; data = rows.clone() },
                    .Err(e) => { _ := sys.eprint("csv2json: " + e); return 2 },
                }
            } else {
                if rows.len == 0 { _ := sys.eprint("csv2json: missing header row"); return 1 }
                header = rows[0].clone()
                for r in 1..rows.len { data.push(rows[r].clone()) }
            }
            print(csv2json.to_json(&data, &header))
        },
        .Err(e) => { _ := sys.eprint("csv2json: " + e); return 1 },
    }
    return 0
}
