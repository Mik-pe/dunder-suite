import std.parse as parse
import std.text as text
import std.sys as sys

import kopia

fn usage() -> i32 {
    _ := sys.eprint("usage: kopia [--keep N] FILE")
    _ := sys.eprint("  --keep N   how many .bak.<ms> siblings to retain (default 5)")
    _ := sys.eprint("  FILE       file to back up as FILE.bak.<now-ms>")
    return 2
}

fn split_path(path: string) -> (string, string) {
    mut last := -1
    for i in 0..path.len {
        if path[i] == 47 { last = i }
    }
    if last < 0 { return (".", path.clone()) }
    if last == 0 { return ("/", path[1..path.len]) }
    (path[0..last], path[last + 1..path.len])
}

fn main() -> i32 {
    mut keep := 5
    mut file := ""
    count := sys.arg_count()
    mut i := 1
    while i < count {
        a := sys.arg(i)
        if a == "--keep" {
            if i + 1 >= count { _ := sys.eprint("kopia: missing value after --keep"); return 2 }
            i += 1
            n := parse.integer(sys.arg(i))
            if !n.ok || n.value < 1 || n.value > 1000 {
                _ := sys.eprint("kopia: --keep must be 1..1000")
                return 2
            }
            keep = i32(n.value)
        } else if text.starts_with(a, "-") && a.len > 1 {
            _ := sys.eprint("kopia: unknown flag " + a)
            return 2
        } else if file.len == 0 {
            file = a.clone()
        } else {
            _ := sys.eprint("kopia: unexpected argument " + a)
            return 2
        }
        i += 1
    }
    if file.len == 0 { return usage() }

    match kopia.backup(file) {
        .Ok(dest) => { print(dest) },
        .Err(e) => { _ := sys.eprint("kopia: " + e); return 1 },
    }
    parts := split_path(file)
    match kopia.prune(parts.0, parts.1, keep) {
        .Ok(removed) => {
            if removed > 0 { print(f"pruned {removed} old backup(s)") }
        },
        .Err(e) => { _ := sys.eprint("kopia: " + e); return 1 },
    }
    return 0
}
