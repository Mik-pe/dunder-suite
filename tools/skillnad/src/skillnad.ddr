import std.text as text

// Unified-lite line diff built on a classic LCS dynamic program. kind values:
// 0 = same (context, omitted by render), 1 = only in A (minus), 2 = only in B
// (plus). Inputs are capped at 2000 lines each.

pub struct DiffLine {
    kind: i32,
    text: string,
}

pub fn diff_lines(a: &[]string, b: &[]string) -> Result<[]DiffLine, string> {
    n := a.len
    m := b.len
    if n > 2000 || m > 2000 { return .Err("input too large: max 2000 lines per file") }
    w := m + 1
    mut table: []i32 = []
    mut k := 0
    while k < (n + 1) * w {
        table.push(0)
        k += 1
    }
    mut i := n - 1
    while i >= 0 {
        mut j := m - 1
        while j >= 0 {
            mut best := 0
            if a[i] == b[j] {
                best = table[(i + 1) * w + (j + 1)] + 1
            } else {
                down := table[(i + 1) * w + j]
                right := table[i * w + (j + 1)]
                if down >= right { best = down } else { best = right }
            }
            table[i * w + j] = best
            j -= 1
        }
        i -= 1
    }

    mut out: []DiffLine = []
    mut x := 0
    mut y := 0
    while x < n || y < m {
        if x < n && y < m && a[x] == b[y] {
            out.push(DiffLine { kind: 0, text: a[x].clone() })
            x += 1
            y += 1
        } else if y >= m || (x < n && table[(x + 1) * w + y] >= table[x * w + (y + 1)]) {
            out.push(DiffLine { kind: 1, text: a[x].clone() })
            x += 1
        } else {
            out.push(DiffLine { kind: 2, text: b[y].clone() })
            y += 1
        }
    }
    .Ok(out)
}

pub fn render(lines: &[]DiffLine) -> string {
    mut parts: []string = []
    mut removed := 0
    mut added := 0
    for line in lines {
        if line.kind == 1 {
            parts.push("-" + line.text.clone())
            removed += 1
        } else if line.kind == 2 {
            parts.push("+" + line.text.clone())
            added += 1
        }
    }
    if removed + added == 0 { return "" }
    parts.push(f"{removed} removed, {added} added")
    mut out := ""
    for part in parts {
        if out.len > 0 { out = out + "\n" }
        out = out + part.clone()
    }
    out
}
