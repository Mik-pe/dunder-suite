import ..src.bas as bas

@test fn parses_hex_case_insensitively() {
    match bas.parse_in_base("ff", 16) {
        .Ok(v) => { assert(v == 255) },
        .Err(e) => { assert(e.len >= 0); assert(false) },
    }
    match bas.parse_in_base("FF", 16) {
        .Ok(v) => { assert(v == 255) },
        .Err(e) => { assert(e.len >= 0); assert(false) },
    }
}

@test fn parses_binary_and_octal() {
    match bas.parse_in_base("1010", 2) {
        .Ok(v) => { assert(v == 10) },
        .Err(e) => { assert(e.len >= 0); assert(false) },
    }
    match bas.parse_in_base("755", 8) {
        .Ok(v) => { assert(v == 493) },
        .Err(e) => { assert(e.len >= 0); assert(false) },
    }
}

@test fn parses_negative_values() {
    match bas.parse_in_base("-ff", 16) {
        .Ok(v) => { assert(v == -255) },
        .Err(e) => { assert(e.len >= 0); assert(false) },
    }
}

@test fn rejects_invalid_digits() {
    assert(bas.parse_in_base("xz", 16).is_err())
    assert(bas.parse_in_base("", 10).is_err())
    assert(bas.parse_in_base("9", 8).is_err())
    assert(bas.parse_in_base("-", 10).is_err())
    assert(bas.parse_in_base("101", 3).is_err())
}

@test fn formats_common_bases() {
    assert(bas.format_base(255, 16) == "ff")
    assert(bas.format_base(255, 2) == "11111111")
    assert(bas.format_base(493, 8) == "755")
    assert(bas.format_base(0, 16) == "0")
}

@test fn formats_negative_with_leading_dash() {
    assert(bas.format_base(-255, 16) == "-ff")
    assert(bas.format_base(-10, 2) == "-1010")
}

@test fn round_trips_through_format_and_parse() {
    match bas.parse_in_base(bas.format_base(4095, 16), 16) {
        .Ok(v) => { assert(v == 4095) },
        .Err(e) => { assert(e.len >= 0); assert(false) },
    }
}
