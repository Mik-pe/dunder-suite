import std.text as text
import sys

import validera

fn usage() -> i32 {
    _ := sys.eprint("usage: validera FILE...")
    _ := sys.eprint("  JSON validator: prints '<path>: ok' or '<path>: error: <msg> at byte <offset>' per file")
    _ := sys.eprint("  exits 1 if any file is invalid")
    return 2
}

fn main() -> i32 {
    mut positional: []string = []
    count := sys.arg_count()
    mut i := 1
    while i < count {
        a := sys.arg(i)
        if text.starts_with(a, "-") && a.len > 1 {
            _ := sys.eprint("validera: unknown flag " + a)
            return 2
        } else {
            positional.push(a.clone())
        }
        i += 1
    }
    if positional.len == 0 { return usage() }

    mut failed := false
    for path in positional {
        content := sys.read_text(path.clone())
        if !content.ok {
            print(path + ": error: cannot read: " + sys.error_message(content.error))
            failed = true
            continue
        }
        mut payload := content.value
        match validera.validate(payload) {
            .Ok => { print(path + ": ok") },
            .Err(msg) => { print(path + ": error: " + msg); failed = true },
        }
    }
    if failed { return 1 }
    return 0
}
