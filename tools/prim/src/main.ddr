import std.array as array
import std.parse as parse
import sys

import prim

fn usage() -> i32 {
    _ := sys.eprint("usage: prim check N      is N prime?")
    _ := sys.eprint("       prim factor N    prime factorization, e.g. 2^3 * 3 * 5")
    _ := sys.eprint("       prim nth N       Nth prime (1-based)")
    _ := sys.eprint("       prim list N      first N primes")
    return 2
}

fn main() -> i32 {
    count := sys.arg_count()
    if count != 3 { return usage() }
    command := sys.arg(1)
    if command != "check" && command != "factor" && command != "nth" && command != "list" {
        return usage()
    }
    n := parse.integer(sys.arg(2))
    if !n.ok {
        _ := sys.eprint("prim: invalid number: " + sys.arg(2))
        return 1
    }
    if n.value > 10000 {
        _ := sys.eprint("prim: N must be <= 10000")
        return 1
    }
    if command == "check" {
        if n.value < 2 {
            _ := sys.eprint("prim: N must be >= 2")
            return 1
        }
        if prim.is_prime(n.value) { print("prime") } else { print("composite") }
        return 0
    }
    if command == "factor" {
        if n.value < 2 {
            _ := sys.eprint("prim: N must be >= 2")
            return 1
        }
        factors := prim.factorize(n.value)
        print(prim.format_factors(&factors))
        return 0
    }
    if command == "nth" {
        if n.value < 1 {
            _ := sys.eprint("prim: N must be >= 1")
            return 1
        }
        print(prim.nth_prime(i32(n.value)).str())
        return 0
    }
    if n.value < 1 {
        _ := sys.eprint("prim: N must be >= 1")
        return 1
    }
    primes := prim.first_primes(i32(n.value))
    print(array.join<i64>(&primes, " "))
    return 0
}
