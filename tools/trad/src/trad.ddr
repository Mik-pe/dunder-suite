capability filesystem

import std.fs as fs
import std.text as text
import sys

fn render_level(dir: string, prefix: string, depth: i32, max_depth: i32) -> string {
    if depth > max_depth { return "" }
    listed := fs.list_dir(dir)
    if !listed.ok { return "" }
    mut out := ""
    entries := listed.entries
    for i in 0..entries.len {
        name := entries[i].clone()
        if text.starts_with(name, ".") { continue }
        is_last := i + 1 == entries.len
        child := dir + "/" + name.clone()
        info := sys.metadata(child)
        is_dir := info.ok && sys.file_kind(info) == .Directory
        connector := if is_last { "`-- " } else { "|-- " }
        mut line := prefix + connector + name.clone()
        if is_dir {
            line = line + "/"
            mut child_prefix := prefix.clone()
            if is_last {
                child_prefix = child_prefix + "    "
            } else {
                child_prefix = child_prefix + "|   "
            }
            body := render_level(child.clone(), child_prefix, depth + 1, max_depth)
            if body.len > 0 {
                mut piece := body
                if piece[piece.len - 1] == 10 { piece = piece[0..piece.len - 1] }
                line = line + "\n" + piece
            }
        }
        out = out + line + "\n"
    }
    out
}

pub fn render_tree(root: string, max_depth: i32) -> Result<string, string> {
    if max_depth < 0 { return .Err("depth must be >= 0") }
    info := sys.metadata(root)
    if !info.ok {
        return .Err("cannot read " + root + ": " + sys.error_message(info.error))
    }
    mut out := root.clone()
    if sys.file_kind(info) == .Directory {
        out = out + "/"
        body := render_level(root, "", 1, max_depth)
        if body.len > 0 {
            out = out + "\n" + body
            if out.len > 0 && out[out.len - 1] == 10 { out = out[0..out.len - 1] }
        }
    }
    .Ok(out)
}
