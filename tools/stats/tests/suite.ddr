import ..src.stats as stats

@test fn parse_numbers_accepts_mixed_separators() {
    parsed := stats.parse_numbers("1 2,3\t4\n5.5")
    assert(parsed.is_ok())
    match parsed {
        .Ok(values) => {
            assert(values.len == 5)
            assert(values[0] == 1.0)
            assert(values[4] == 5.5)
        },
        .Err(e) => { assert(e.len >= 0); assert(false) },
    }
}

@test fn parse_numbers_rejects_garbage_and_empty() {
    assert(stats.parse_numbers("1 x 2").is_err())
    assert(stats.parse_numbers("   ").is_err())
}

@test fn summarize_computes_count_min_max_mean() {
    values: []f64 = [10.0, 2.0, 8.0, 4.0]
    report := stats.summarize(&values)
    assert(report.count == 4)
    assert(report.min == 2.0)
    assert(report.max == 10.0)
    assert(report.mean == 6.0)
}

@test fn summarize_median_averages_middle_pair_for_even_counts() {
    values: []f64 = [1.0, 2.0, 3.0, 4.0]
    report := stats.summarize(&values)
    assert(report.median == 2.5)
}

@test fn summarize_median_is_middle_value_for_odd_counts() {
    values: []f64 = [10.0, 1.0, 2.0]
    report := stats.summarize(&values)
    assert(report.median == 2.0)
}

@test fn summarize_computes_population_stdev() {
    values: []f64 = [1.0, 2.0, 3.0, 4.0]
    report := stats.summarize(&values)
    // population stdev of 1,2,3,4 is sqrt(1.25) = 1.1180...
    assert(report.stdev - 1.1180 < 0.001)
    assert(1.1180 - report.stdev < 0.001)
}

@test fn render_formats_two_decimals() {
    values: []f64 = [1.0, 2.0, 3.0, 4.0]
    report := stats.summarize(&values)
    expected := "count   4\nmin     1\nmax     4\nmean    2.5\nmedian  2.5\nstdev   1.12\n"
    assert(stats.render(&report) == expected)
}

@test fn format_2_trims_and_rounds() {
    assert(stats.format_2(1.0) == "1")
    assert(stats.format_2(3.6666666666666665) == "3.67")
    assert(stats.format_2(-0.5) == "-0.5")
    assert(stats.format_2(0.0) == "0")
}
