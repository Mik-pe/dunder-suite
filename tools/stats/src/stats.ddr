// stats — summary statistics for series of numbers.

import std.array as array
import std.math as math
import std.parse as parse

pub struct Report {
    count: i32,
    min: f64,
    max: f64,
    mean: f64,
    median: f64,
    stdev: f64,
}

fn is_separator(b: i32) -> bool {
    b == 32 || b == 9 || b == 10 || b == 13 || b == 44
}

pub fn parse_numbers(input: string) -> Result<[]f64, string> {
    mut values: []f64 = []
    mut start := -1
    end := input.len + 1
    for i in 0..end {
        at_end := i == input.len
        if at_end || is_separator(input[i]) {
            if start >= 0 {
                token := input[start..i]
                match parse.value<f64>(token) {
                    .Ok(v) => {
                        if !v.is_finite() {
                            return .Err("not a finite number: " + token)
                        }
                        values.push(v)
                    },
                    .Err(e) => { return .Err(e.clone()) },
                }
                start = -1
            }
        } else if start < 0 {
            start = i
        }
    }
    if values.len == 0 { return .Err("no numbers found in input") }
    .Ok(values)
}

// Two-decimal display formatting via integer math on v*100.
pub fn format_2(v: f64) -> string {
    a := if v < 0.0 { -v } else { v }
    if a > 1000000000000000.0 { return v.str() }
    negative := v < 0.0
    cents := i64(a * 100.0 + 0.5)
    whole := cents / 100
    frac := cents % 100
    if !negative && whole == 0 && frac == 0 { return "0" }
    sign := if negative { "-" } else { "" }
    if frac == 0 { return sign + whole.str() }
    if frac % 10 == 0 { return sign + whole.str() + "." + (frac / 10).str() }
    sign + whole.str() + "." + f"{frac:02}"
}

fn sqrt_approx(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 }
    mut r := x
    if r < 1.0 { r = 1.0 }
    for _ in 0..80 { r = (r + x / r) / 2.0 }
    r
}

pub fn summarize(values: &[]f64) -> Report {
    assert(values.len > 0)
    mut sorted: []f64 = []
    for i in 0..values.len { sorted.push(values[i]) }
    array.sort_by<f64>(&mut sorted, math.total_cmp_f64)
    mut sum := 0.0
    for v in sorted { sum += v }
    mean := sum / f64(sorted.len)
    half := sorted.len / 2
    mut median := sorted[half]
    if sorted.len % 2 == 0 {
        median = (sorted[half - 1] + sorted[half]) / 2.0
    }
    mut sq := 0.0
    for v in sorted {
        d := v - mean
        sq += d * d
    }
    Report {
        count: sorted.len,
        min: sorted[0],
        max: sorted[sorted.len - 1],
        mean: mean,
        median: median,
        stdev: sqrt_approx(sq / f64(sorted.len)),
    }
}

pub fn render(report: &Report) -> string {
    mut out := "count   " + report.count.str() + "\n"
    out = out + "min     " + format_2(report.min) + "\n"
    out = out + "max     " + format_2(report.max) + "\n"
    out = out + "mean    " + format_2(report.mean) + "\n"
    out = out + "median  " + format_2(report.median) + "\n"
    out = out + "stdev   " + format_2(report.stdev) + "\n"
    out
}
