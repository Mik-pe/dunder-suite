import std.text as text

pub fn to_lines(content: string) -> []string {
    mut lines: []string = []
    parts := text.split(content, "\n")
    last := parts.len - 1
    mut i := 0
    for part in parts {
        if !(i == last && part.len == 0) {
            lines.push(part.clone())
        }
        i += 1
    }
    lines
}

pub struct Pair { text: string, count: i32 }

pub fn collapse(lines: &[]string) -> []Pair {
    mut out: []Pair = []
    mut i := 0
    while i < lines.len {
        current := lines[i].clone()
        mut n := 1
        while i + n < lines.len && lines[i + n] == current {
            n += 1
        }
        out.push(Pair { text: current.clone(), count: n })
        i += n
    }
    out
}

pub fn render(pairs: &[]Pair, show_counts: bool) -> string {
    mut out := ""
    for p in pairs {
        if out.len > 0 { out = out + "\n" }
        if show_counts {
            out = out + f"{p.count:7} " + p.text
        } else {
            out = out + p.text
        }
    }
    out
}
