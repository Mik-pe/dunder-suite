import ..src.rakna as rakna

@test fn evaluates_precedence() {
    match rakna.eval("2 + 3 * 4") {
        .Ok(v) => { assert(v == 14) },
        .Err(e) => { assert(e.len >= 0); assert(false) },
    }
}

@test fn evaluates_parentheses() {
    match rakna.eval("2 + 3 * (4 - 1)") {
        .Ok(v) => { assert(v == 11) },
        .Err(e) => { assert(e.len >= 0); assert(false) },
    }
}

@test fn evaluates_modulo_and_division() {
    match rakna.eval("10 % 3 + 7 / 2") {
        .Ok(v) => { assert(v == 4) },
        .Err(e) => { assert(e.len >= 0); assert(false) },
    }
}

@test fn evaluates_unary_minus_and_nested_parens() {
    match rakna.eval("-(2 + 3) * 4") {
        .Ok(v) => { assert(v == -20) },
        .Err(e) => { assert(e.len >= 0); assert(false) },
    }
    match rakna.eval("((1 + 1) * (2 + 3))") {
        .Ok(v) => { assert(v == 10) },
        .Err(e) => { assert(e.len >= 0); assert(false) },
    }
}

@test fn division_by_zero_is_an_error() {
    assert(rakna.eval("1 / 0").is_err())
    assert(rakna.eval("5 % 0").is_err())
}

@test fn garbage_input_is_an_error() {
    assert(rakna.eval("2 + x").is_err())
    assert(rakna.eval("").is_err())
    assert(rakna.eval("42x").is_err())
}

@test fn unbalanced_parentheses_is_an_error() {
    assert(rakna.eval("(1 + 2").is_err())
    assert(rakna.eval("1 + 2)").is_err())
}

@test fn whitespace_is_flexible() {
    match rakna.eval("  7*6  ") {
        .Ok(v) => { assert(v == 42) },
        .Err(e) => { assert(e.len >= 0); assert(false) },
    }
}
