import std.json as json

fn write_compact(doc: &json.Doc, node: i32) -> string {
    kind := doc.kind(node)
    if kind == .Object {
        count := doc.count(node)
        mut out := "{"
        for i in 0..count {
            if i > 0 { out = out + "," }
            key := doc.key_at(node, i)
            if key.ok {
                out = out + json.quote(key.value) + ":" + write_compact(doc, doc.val_at(node, i))
            }
        }
        return out + "}"
    }
    if kind == .Array {
        count := doc.count(node)
        mut out := "["
        for i in 0..count {
            if i > 0 { out = out + "," }
            out = out + write_compact(doc, doc.at(node, i))
        }
        return out + "]"
    }
    if kind == .String { return json.quote(doc.as_str(node).value) }
    doc.raw_span(node)
}

pub fn minify(json_text: string) -> Result<string, string> {
    doc := json.Doc::parse_text(json_text)
    if !doc.ok { return .Err(f"{doc.error} at byte {doc.offset}") }
    .Ok(write_compact(&doc, doc.root))
}
