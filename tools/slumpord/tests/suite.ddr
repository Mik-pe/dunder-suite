import std.text as text

import ..src.slumpord as slumpord

fn has_word(words: &[]string, w: string) -> bool {
    mut i := 0
    while i < words.len {
        if words[i] == w { return true }
        i += 1
    }
    false
}

fn is_lower_ascii(s: string) -> bool {
    for b in s.bytes() {
        if b < 97 || b > 122 { return false }
    }
    true
}

@test fn wordlist_has_40_unique_short_ascii_words() {
    words := slumpord.wordlist()
    assert(words.len == 40)
    mut seen: []string = []
    for w in words {
        assert(w.len >= 2 && w.len <= 7)
        assert(is_lower_ascii(w.clone()))
        assert(!has_word(&seen, w.clone()))
        seen.push(w.clone())
    }
    assert(has_word(&words, "apa"))
    assert(has_word(&words, "zenit"))
}

@test fn pick_words_honours_count_and_separator() {
    all_words := slumpord.wordlist()
    match slumpord.pick_words(1, "-") {
        .Ok(p) => {
            parts := text.split(p, "-")
            assert(parts.len == 1)
            assert(has_word(&all_words, parts[0].clone()))
        },
        .Err(_) => { assert(false) },
    }
    match slumpord.pick_words(6, ".") {
        .Ok(p) => {
            parts := text.split(p, ".")
            assert(parts.len == 6)
            for part in parts {
                assert(has_word(&all_words, part.clone()))
            }
        },
        .Err(_) => { assert(false) },
    }
    assert(slumpord.pick_words(0, "-").is_err())
    assert(slumpord.pick_words(65, "-").is_err())
}

@test fn pick_words_never_repeats_consecutively() {
    words := slumpord.wordlist()
    mut round := 0
    while round < 50 {
        picked := slumpord.pick_words(8, "-")
        match picked {
            .Ok(p) => {
                parts := text.split(p, "-")
                assert(parts.len == 8)
                mut k := 1
                while k < parts.len {
                    assert(parts[k] != parts[k - 1])
                    k += 1
                }
                for part in parts { assert(has_word(&words, part.clone())) }
            },
            .Err(_) => { assert(false) },
        }
        round += 1
    }
}

@test fn hex_token_is_32_lowercase_hex_chars() {
    match slumpord.hex_token() {
        .Ok(t) => {
            assert(t.len == 32)
            for b in t.bytes() {
                ok := (b >= 48 && b <= 57) || (b >= 97 && b <= 102)
                assert(ok)
            }
        },
        .Err(_) => { assert(false) },
    }
    first := slumpord.hex_token()
    second := slumpord.hex_token()
    match first {
        .Ok(a) => {
            match second {
                .Ok(b) => { assert(a != b) },
                .Err(_) => { assert(false) },
            }
        },
        .Err(_) => { assert(false) },
    }
}
