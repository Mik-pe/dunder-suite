import std.text as text
import sys

import citera

fn usage() -> i32 {
    _ := sys.eprint("usage: citera [--unescape] [FILE | args...]")
    _ := sys.eprint("  prints each input line as a JSON string (or reverses with --unescape)")
    _ := sys.eprint("  no arguments reads stdin; an argument naming a file is read as a file;")
    _ := sys.eprint("  multiple arguments are treated as individual lines")
    return 2
}

fn strip_one_newline(s: string) -> string {
    if text.ends_with(s, "\n") { return s[0..s.len - 1] }
    s.clone()
}

fn main() -> i32 {
    count := sys.arg_count()
    mut unescape := false
    mut inputs: []string = []
    mut i := 1
    while i < count {
        a := sys.arg(i)
        if a == "--unescape" {
            unescape = true
        } else if text.starts_with(a, "-") && a.len > 1 && a != "-" {
            _ := sys.eprint("citera: unknown flag " + a)
            return 2
        } else {
            inputs.push(a.clone())
        }
        i += 1
    }

    mut lines: []string = []
    if inputs.len == 0 {
        data := sys.read_text("/dev/stdin")
        if !data.ok { _ := sys.eprint("citera: cannot read stdin: " + sys.error_message(data.error)); return 1 }
        lines = text.split(strip_one_newline(data.value), "\n")
    } else if inputs.len == 1 {
        arg := inputs[0].clone()
        info := sys.metadata(arg.clone())
        if info.ok && sys.file_kind(info) == .File {
            data := sys.read_text(arg.clone())
            if !data.ok { _ := sys.eprint("citera: cannot read " + arg + ": " + sys.error_message(data.error)); return 1 }
            lines = text.split(strip_one_newline(data.value), "\n")
        } else {
            lines.push(arg.clone())
        }
    } else {
        for arg in inputs { lines.push(arg.clone()) }
    }

    mut lineno := 0
    mut failed := false
    for line in lines {
        lineno += 1
        if unescape {
            match citera.unquote_line(line.clone()) {
                .Ok(v) => { print(v) },
                .Err(e) => { _ := sys.eprint("citera: line " + lineno.str() + ": " + e); failed = true },
            }
        } else {
            print(citera.quote_line(line.clone()))
        }
    }
    if failed { return 1 }
    return 0
}
