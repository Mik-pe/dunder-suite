// Unix timestamp conversion, all math in i64 seconds, UTC only (no local
// time, no leap seconds). civil_from_days / days_from_civil are Howard
// Hinnant's public-domain algorithms.

pub fn days_from_civil(y: i64, m: i32, d: i32) -> i64 {
    mut yy := y
    if m <= 2 { yy -= 1 }
    era := yy / 400
    yoe := yy - era * 400
    mut mp := m + 9
    if m > 2 { mp = m - 3 }
    doy := (153 * mp + 2) / 5 + d - 1
    doe := yoe * 365 + yoe / 4 - yoe / 100 + i64(doy)
    era * 146097 + i64(doe) - 719468
}

pub fn civil_from_days(z: i64) -> (i64, i32, i32) {
    zz := z + 719468
    era := zz / 146097
    doe := zz - era * 146097
    yoe := (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    y := yoe + era * 400
    doy := doe - (365 * yoe + yoe / 4 - yoe / 100)
    mp: i64 = (5 * doy + 2) / 153
    d: i64 = doy - (153 * mp + 2) / 5 + 1
    mut m := mp + 3
    if mp >= 10 { m = mp - 9 }
    mut yy := y
    if m <= 2 { yy += 1 }
    (yy, i32(m), i32(d))
}

pub fn format_timestamp(sec: i64) -> Result<string, string> {
    mut days := sec / 86400
    mut rem := sec % 86400
    if rem < 0 {
        rem += 86400
        days -= 1
    }
    civil := civil_from_days(days)
    if civil.0 < 1 || civil.0 > 9999 {
        return .Err("timestamp out of supported range (years 1..9999)")
    }
    hh := rem / 3600
    mm := (rem / 60) % 60
    ss := rem % 60
    .Ok(f"{civil.0:04}-{civil.1:02}-{civil.2:02} {hh:02}:{mm:02}:{ss:02} UTC")
}

fn digit(b: i32) -> i64 {
    if b >= 48 && b <= 57 { return i64(b - 48) }
    -1
}

fn part(raw: &[]i32, from: i32, len: i32) -> i64 {
    mut v: i64 = 0
    mut i := from
    while i < from + len {
        d := digit(i32(raw[i]))
        if d < 0 { return -1 }
        v = v * 10 + d
        i += 1
    }
    v
}

pub fn parse_timestamp(s: string) -> Result<i64, string> {
    if s.len != 19 { return .Err("expected 'YYYY-MM-DD HH:MM:SS' (19 characters)") }
    raw := s.bytes()
    if i32(raw[4]) != 45 || i32(raw[7]) != 45 || i32(raw[10]) != 32 || i32(raw[13]) != 58 || i32(raw[16]) != 58 {
        return .Err("expected 'YYYY-MM-DD HH:MM:SS' with '-' ' ' ':' separators")
    }
    y := part(&raw, 0, 4)
    mo := part(&raw, 5, 2)
    d := part(&raw, 8, 2)
    h := part(&raw, 11, 2)
    mi := part(&raw, 14, 2)
    se := part(&raw, 17, 2)
    if y < 0 || mo < 0 || d < 0 || h < 0 || mi < 0 || se < 0 { return .Err("expected digits") }
    if y < 1 || y > 9999 { return .Err("year out of range 1..9999") }
    if mo < 1 || mo > 12 { return .Err("month out of range 1..12") }
    if d < 1 || d > 31 { return .Err("day out of range 1..31") }
    if h > 23 { return .Err("hour out of range 0..23") }
    if mi > 59 { return .Err("minute out of range 0..59") }
    if se > 59 { return .Err("second out of range 0..59") }
    days := days_from_civil(y, i32(mo), i32(d))
    check := civil_from_days(days)
    if check.0 != y || i64(check.1) != mo || i64(check.2) != d {
        return .Err("invalid date (that day does not exist)")
    }
    .Ok(days * 86400 + h * 3600 + mi * 60 + se)
}
