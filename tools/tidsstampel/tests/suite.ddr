import ..src.tidsstampel as tidsstampel

@test fn format_timestamp_reference_values() {
    match tidsstampel.format_timestamp(0) {
        .Ok(s) => { assert(s == "1970-01-01 00:00:00 UTC") },
        .Err(_) => { assert(false) },
    }
    match tidsstampel.format_timestamp(1) {
        .Ok(s) => { assert(s == "1970-01-01 00:00:01 UTC") },
        .Err(_) => { assert(false) },
    }
    match tidsstampel.format_timestamp(-1) {
        .Ok(s) => { assert(s == "1969-12-31 23:59:59 UTC") },
        .Err(_) => { assert(false) },
    }
    match tidsstampel.format_timestamp(1763640000) {
        .Ok(s) => { assert(s == "2025-11-20 12:00:00 UTC") },
        .Err(_) => { assert(false) },
    }
    match tidsstampel.format_timestamp(951782400) {
        .Ok(s) => { assert(s == "2000-02-29 00:00:00 UTC") },
        .Err(_) => { assert(false) },
    }
    match tidsstampel.format_timestamp(4102444800) {
        .Ok(s) => { assert(s == "2100-01-01 00:00:00 UTC") },
        .Err(_) => { assert(false) },
    }
    match tidsstampel.format_timestamp(-62135596800) {
        .Ok(s) => { assert(s == "0001-01-01 00:00:00 UTC") },
        .Err(_) => { assert(false) },
    }
}

@test fn parse_and_format_roundtrip() {
    samples := [0, 1, -1, -86400, 951782400, 1763640000, 4102444800, -62135596800, 253402300799]
    for sec in samples {
        match tidsstampel.format_timestamp(sec) {
            .Ok(text) => {
                match tidsstampel.parse_timestamp(text[0..19]) {
                    .Ok(back) => { assert(back == sec) },
                    .Err(_) => { assert(false) },
                }
            },
            .Err(_) => { assert(false) },
        }
    }
    match tidsstampel.parse_timestamp("2025-11-20 12:00:00") {
        .Ok(sec) => { assert(sec == 1763640000) },
        .Err(_) => { assert(false) },
    }
    match tidsstampel.parse_timestamp("2024-02-29 00:00:00") {
        .Ok(sec) => { assert(sec == 1709164800) },
        .Err(_) => { assert(false) },
    }
}

@test fn parse_timestamp_rejects_bad_input() {
    bad := ["2025-13-01 00:00:00", "2025-00-10 00:00:00", "2025-02-30 00:00:00",
            "2023-02-29 00:00:00", "2025-11-21 24:00:00", "2025-11-21 12:60:00",
            "2025-11-21 12:00:60", "2025-1-21 12:00:00", "not a timestamp",
            "2025/11/21 12:00:00", "2025-11-21  12:00:00", "2025-11-21T12:00:00"]
    for s in bad {
        assert(tidsstampel.parse_timestamp(s.clone()).is_err())
    }
}

@test fn format_timestamp_rejects_out_of_range_years() {
    assert(tidsstampel.format_timestamp(253402300800).is_err())
    assert(tidsstampel.format_timestamp(-62135596801).is_err())
}

@test fn civil_roundtrip_over_leap_boundaries() {
    check_one := fn(y: i64, m: i32, d: i32) -> bool {
        days := tidsstampel.days_from_civil(y, m, d)
        back := tidsstampel.civil_from_days(days)
        back.0 == y && back.1 == m && back.2 == d
    }
    assert(check_one(2024, 2, 29))
    assert(check_one(2023, 2, 28))
    assert(check_one(2000, 1, 1))
    assert(check_one(1999, 12, 31))
    assert(check_one(1970, 1, 1))
    assert(check_one(1969, 12, 31))
    assert(check_one(2100, 3, 1))
    assert(check_one(1, 1, 1))
    assert(check_one(9999, 12, 31))
    assert(tidsstampel.days_from_civil(1970, 1, 1) == 0)
    assert(tidsstampel.days_from_civil(1970, 1, 2) == 1)
    assert(tidsstampel.days_from_civil(1969, 12, 31) == -1)
}
