import std.parse as parse
import std.text as text
import sys

import snygga

fn usage() -> i32 {
    _ := sys.eprint("usage: snygga [-i N] [--compact-flat] [FILE]")
    _ := sys.eprint("  JSON pretty-printer: indent N spaces (default 2)")
    _ := sys.eprint("  --compact-flat prints arrays of scalars inline, like [1, 2, 3]; objects stay multi-line")
    _ := sys.eprint("  reads stdin when FILE is omitted or '-'")
    return 2
}

fn main() -> i32 {
    mut indent := 2
    mut flat := false
    mut positional: []string = []
    count := sys.arg_count()
    mut i := 1
    while i < count {
        a := sys.arg(i)
        if a == "-i" || a == "--indent" {
            if i + 1 >= count { _ := sys.eprint("snygga: missing value after " + a); return 2 }
            i += 1
            n := parse.integer(sys.arg(i))
            if !n.ok || n.value < 0 || n.value > 16 {
                _ := sys.eprint("snygga: indent must be 0..16")
                return 2
            }
            indent = i32(n.value)
        } else if a == "--compact-flat" {
            flat = true
        } else if text.starts_with(a, "-") && a.len > 1 {
            _ := sys.eprint("snygga: unknown flag " + a)
            return 2
        } else {
            positional.push(a.clone())
        }
        i += 1
    }
    if positional.len > 1 { return usage() }

    mut read_path := "/dev/stdin"
    if positional.len == 1 && positional[0] != "-" { read_path = positional[0].clone() }
    content := sys.read_text(read_path)
    if !content.ok {
        _ := sys.eprint("snygga: cannot read " + read_path + ": " + sys.error_message(content.error))
        return 1
    }
    mut payload := content.value
    match snygga.pretty(payload, indent, flat) {
        .Ok(out) => { print(out) },
        .Err(e) => { _ := sys.eprint("snygga: " + e); return 1 },
    }
    return 0
}
