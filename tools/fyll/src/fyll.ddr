import std.text as text

pub fn to_lines(content: string) -> []string {
    mut lines: []string = []
    parts := text.split(content, "\n")
    last := parts.len - 1
    mut i := 0
    for part in parts {
        if !(i == last && part.len == 0) {
            lines.push(part.clone())
        }
        i += 1
    }
    lines
}

fn rune_list(s: string) -> []string {
    mut out: []string = []
    for r in s.runes() {
        out.push(r.str())
    }
    out
}

fn repeat(base: string, n: i32) -> string {
    mut out := base.clone()
    for _ in 0..n {
        out = out + " "
    }
    out
}

pub fn rune_len(s: string) -> i32 {
    mut n := 0
    for r in s.runes() {
        n += 1
    }
    n
}

pub fn pad_line(s: string, width: i32, mode: string, truncate: bool) -> string {
    mut w := width
    if w < 0 { w = 0 }
    runes := rune_list(s)
    if truncate && runes.len > w {
        mut cut := ""
        for i in 0..w {
            cut = cut + runes[i].clone()
        }
        return cut
    }
    if runes.len >= w {
        return s.clone()
    }
    pad := w - runes.len
    if mode == "right" {
        repeat("", pad) + s.clone()
    } else if mode == "center" {
        left := pad / 2
        repeat("", left) + s.clone() + repeat("", pad - left)
    } else {
        s.clone() + repeat("", pad)
    }
}
