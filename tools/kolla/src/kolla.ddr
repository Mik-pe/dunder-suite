import std.bytes as bytes
import std.sha256 as sha256
import std.text as text
import sys

// sha256sum-style checksums: lowercase hex, two spaces, path. Files are
// capped at 64 MiB to keep whole-file reads honest.

// sha256 ships two digest entry points; digest_bytes works directly on the
// []u8 byte arrays that sys.read_u8 produces.

pub fn checksum(path: string) -> Result<string, string> {
    info := sys.metadata(path)
    if !info.ok { return .Err("cannot read " + path.clone() + ": " + sys.error_message(info.error)) }
    if sys.file_kind(info) != .File { return .Err("not a file: " + path.clone()) }
    if info.size > 67108864 { return .Err("file too large (max 64 MiB): " + path.clone()) }
    data := sys.read_u8(path)
    if !data.ok { return .Err("cannot read " + path.clone() + ": " + sys.error_message(data.error)) }
    .Ok(bytes.hex_u8(&sha256.digest_bytes(&data.value)))
}

// Verify one "<hex>  <path>" line; Ok carries an OK status line, Err carries
// the FAIL status line (mismatch, unreadable file, or malformed line).
pub fn verify_line(line: string) -> Result<string, string> {
    mut clean := line.clone()
    if text.ends_with(clean, "\n") { clean = clean[0..clean.len - 1] }
    if text.ends_with(clean, "\r") { clean = clean[0..clean.len - 1] }
    sep := text.find(clean, "  ")
    if sep < 0 { return .Err("FAIL (malformed line): " + clean) }
    hex := clean[0..sep]
    path := clean[sep + 2..clean.len]
    if hex.len != 64 { return .Err("FAIL (malformed checksum): " + path) }
    match checksum(path.clone()) {
        .Ok(actual) => {
            if actual == hex { return .Ok(path + ": OK") }
            return .Err(path + ": FAIL (expected " + hex + ", got " + actual + ")")
        },
        .Err(e) => { return .Err(path + ": FAIL (" + e + ")") },
    }
}
