capability filesystem

import std.fs as fs
import std.sys as sys
import std.text as text

import ..src.titta as titta

@test fn parse_ms_validates_range_and_spelling() {
    match titta.parse_ms("--interval-ms", "250") {
        .Ok(v) => { assert(v == 250) },
        .Err(e) => { assert(e.len >= 0); assert(false) },
    }
    assert(titta.parse_ms("--interval-ms", "9").is_err())
    assert(titta.parse_ms("--interval-ms", "0").is_err())
    assert(titta.parse_ms("--interval-ms", "3600001").is_err())
    assert(titta.parse_ms("--interval-ms", "soon").is_err())
    assert(titta.parse_ms("--interval-ms", "").is_err())
}

@test fn wait_for_change_times_out_when_file_stays_still() {
    dir := fs.temp_dir("titta-suite-")
    if !dir.ok { assert(false); return }
    root := dir.value
    defer { _ := fs.remove_all(root) }
    _ := sys.write_text(root + "/watched.txt", "stable\n")
    match titta.wait_for_change(root + "/watched.txt", 10, 80) {
        .Ok(pair) => { assert(pair.0 >= 0); assert(false) },
        .Err(e) => { assert(text.find(e, "timeout") >= 0) },
    }
}

@test fn wait_for_change_rejects_missing_files_and_bad_intervals() {
    dir := fs.temp_dir("titta-missing-")
    if !dir.ok { assert(false); return }
    root := dir.value
    defer { _ := fs.remove_all(root) }
    match titta.wait_for_change(root + "/nope", 10, 50) {
        .Ok(pair) => { assert(pair.0 >= 0); assert(false) },
        .Err(e) => { assert(e.len > 0) },
    }
    assert(titta.wait_for_change(root, 1, 50).is_err())
}
