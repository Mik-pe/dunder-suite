capability network

import std.array as array
import std.json as json
import std.math as math
import std.sys as sys

import http_client

pub struct Config {
    url: string,
    method: string,
    total: i32,
    duration_ms: i64,
    timeout_ms: i64,
    max_bytes: i64,
    header_names: []string,
    header_values: []string,
    body: []u8,
}

pub fn default_config(move url: string) -> Config {
    Config {
        url: url,
        method: "GET",
        total: 10,
        duration_ms: 0,
        timeout_ms: 5000,
        max_bytes: 1048576,
        header_names: [],
        header_values: [],
        body: [],
    }
}

pub struct Sample {
    status: i32,
    transport_code: i32,
    latency_ms: i64,
    ok: bool,
    error: string,
}

pub fn request_once(cfg: &Config) -> Sample {
    started := sys.now_ms()
    response := http_client.request(
        cfg.method,
        cfg.url,
        &cfg.header_names,
        &cfg.header_values,
        &cfg.body,
        cfg.timeout_ms,
        cfg.max_bytes,
    )
    elapsed := sys.now_ms() - started
    Sample {
        status: response.status,
        transport_code: response.transport_code,
        latency_ms: elapsed,
        ok: response.ok,
        error: response.error.clone(),
    }
}

pub fn run(cfg: &Config) -> Result<([]Sample, i64), string> {
    if cfg.total > 0 && cfg.duration_ms > 0 {
        return .Err("choose either -n COUNT or -t SECONDS, not both")
    }
    if cfg.total <= 0 && cfg.duration_ms <= 0 {
        return .Err("nothing to do: set a request count or a duration")
    }
    mut samples: []Sample = []
    started := sys.now_ms()
    if cfg.total > 0 {
        mut i := 0
        while i < cfg.total {
            sample := request_once(cfg)
            if i == 0 && !sample.ok {
                return .Err("first request failed: " + sample.error +
                    " (transport code " + sample.transport_code.str() + ")")
            }
            samples.push(sample.clone())
            i += 1
        }
    } else {
        while true {
            if sys.now_ms() - started >= cfg.duration_ms { break }
            sample := request_once(cfg)
            if samples.len == 0 && !sample.ok {
                return .Err("first request failed: " + sample.error +
                    " (transport code " + sample.transport_code.str() + ")")
            }
            samples.push(sample.clone())
        }
    }
    wall := sys.now_ms() - started
    .Ok((samples, wall))
}

pub struct Report {
    count: i32,
    wall_ms: i64,
    rps: f64,
    min_ms: f64,
    p50_ms: f64,
    p90_ms: f64,
    p95_ms: f64,
    p99_ms: f64,
    max_ms: f64,
    transport_failures: i32,
}

fn percentile(sorted: &[]f64, fraction: f64) -> f64 {
    if sorted.len == 0 { return 0.0 }
    if sorted.len == 1 { return sorted[0] }
    mut idx := i32(fraction * f64(sorted.len - 1) + 0.5)
    if idx < 0 { idx = 0 }
    if idx >= sorted.len { idx = sorted.len - 1 }
    sorted[idx]
}

pub fn summarize(samples: &[]Sample, wall_ms: i64) -> Report {
    mut latencies: []f64 = []
    mut failures := 0
    for s in samples {
        latencies.push(f64(s.latency_ms))
        if !s.ok { failures += 1 }
    }
    array.sort_by<f64>(&mut latencies, math.total_cmp_f64)
    mut rps := 0.0
    if wall_ms > 0 { rps = f64(samples.len) * 1000.0 / f64(wall_ms) }
    Report {
        count: samples.len,
        wall_ms: wall_ms,
        rps: rps,
        min_ms: percentile(&latencies, 0.0),
        p50_ms: percentile(&latencies, 0.5),
        p90_ms: percentile(&latencies, 0.9),
        p95_ms: percentile(&latencies, 0.95),
        p99_ms: percentile(&latencies, 0.99),
        max_ms: percentile(&latencies, 1.0),
        transport_failures: failures,
    }
}

pub fn render_text(report: &Report) -> string {
    mut out := f"{report.count} requests in {report.wall_ms} ms ("
    out = out + one_decimal(report.rps) + " rps)\n"
    out = out + "latency ms: p50=" + whole(report.p50_ms)
    out = out + " p90=" + whole(report.p90_ms)
    out = out + " p95=" + whole(report.p95_ms)
    out = out + " p99=" + whole(report.p99_ms)
    out = out + " max=" + whole(report.max_ms) + "\n"
    out = out + "transport: failures=" + report.transport_failures.str() + "\n"
    out
}

pub fn render_json(report: &Report) -> string {
    mut w := json.Writer::new()
    w.object()
    w.key("count")
    w.integer(i64(report.count))
    w.key("wall_ms")
    w.integer(report.wall_ms)
    w.key("rps")
    w.decimal(report.rps)
    w.key("p50_ms")
    w.decimal(report.p50_ms)
    w.key("p90_ms")
    w.decimal(report.p90_ms)
    w.key("p95_ms")
    w.decimal(report.p95_ms)
    w.key("p99_ms")
    w.decimal(report.p99_ms)
    w.key("max_ms")
    w.decimal(report.max_ms)
    w.key("transport_failures")
    w.integer(i64(report.transport_failures))
    w.end()
    done := w.finish()
    if done.ok { return done.value }
    "{}"
}

fn whole(v: f64) -> string {
    i64(v + 0.5).str()
}

fn one_decimal(v: f64) -> string {
    tenths := i64(v * 10.0 + 0.5)
    f"{tenths / 10}.{tenths % 10}"
}
