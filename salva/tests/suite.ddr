import std.json as json

import ..src.salva as salva

fn sample(latency: i64, status: i32, ok: bool) -> salva.Sample {
    salva.Sample {
        status: status,
        transport_code: if ok { 0 } else { 7 },
        latency_ms: latency,
        ok: ok,
        error: "",
    }
}

fn samples_1_to_100() -> []salva.Sample {
    mut values: []salva.Sample = []
    for i in 1..101 {
        values.push(sample(i64(i), 200, true))
    }
    values
}

@test fn summarize_computes_percentiles_on_known_series() {
    values := samples_1_to_100()
    report := salva.summarize(&values, 1000)
    assert(report.count == 100)
    assert(report.wall_ms == 1000)
    assert(report.rps == 100.0)
    assert(report.min_ms == 1.0)
    assert(report.p50_ms == 51.0)
    assert(report.p90_ms == 90.0)
    assert(report.p95_ms == 95.0)
    assert(report.p99_ms == 99.0)
    assert(report.max_ms == 100.0)
    assert(report.transport_failures == 0)
}

@test fn summarize_counts_transport_failures_and_handles_empty() {
    mut mixed: []salva.Sample = []
    mixed.push(sample(5, 200, true))
    mixed.push(sample(9, 0, false))
    mixed.push(sample(7, 502, true))
    report := salva.summarize(&mixed, 100)
    assert(report.count == 3)
    assert(report.transport_failures == 1)
    assert(report.min_ms == 5.0)
    assert(report.max_ms == 9.0)
    assert(report.rps == 30.0)

    empty: []salva.Sample = []
    blank := salva.summarize(&empty, 0)
    assert(blank.count == 0)
    assert(blank.p50_ms == 0.0)
}

@test fn run_rejects_conflicting_and_empty_modes() {
    mut cfg := salva.default_config("http://127.0.0.1:1/")
    cfg.total = 0
    cfg.duration_ms = 0
    assert(salva.run(&cfg).is_err())

    cfg.total = 5
    cfg.duration_ms = 1000
    assert(salva.run(&cfg).is_err())
}

@test fn render_text_reports_the_essentials() {
    values := samples_1_to_100()
    report := salva.summarize(&values, 2000)
    rendered := salva.render_text(&report)
    assert(rendered == "100 requests in 2000 ms (50.0 rps)\n" +
        "latency ms: p50=51 p90=90 p95=95 p99=99 max=100\n" +
        "transport: failures=0\n")
}

@test fn render_json_round_trips_through_the_json_parser() {
    values := samples_1_to_100()
    report := salva.summarize(&values, 1000)
    doc := json.Doc::parse_text(salva.render_json(&report))
    assert(doc.ok)
    assert(doc.get_i64(doc.root, "count").value == 100)
    assert(doc.get_f64(doc.root, "rps").value == 100.0)
    assert(doc.get_f64(doc.root, "p95_ms").value == 95.0)
    assert(doc.get_i64(doc.root, "transport_failures").value == 0)
}
