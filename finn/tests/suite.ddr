capability filesystem

import std.fs as fs
import sys

import ..src.finn as finn

fn make_tree() -> Result<string, string> {
    dir := fs.temp_dir("finn-suite-")
    if !dir.ok { return .Err("temp_dir failed") }
    root := dir.value
    _ := sys.write_text(root + "/alpha.ddr", "fn one() {}\n// TODO fix this\nfn two() {}\n")
    _ := sys.write_text(root + "/beta.txt", "nothing to see\nmove along\n")
    _ := sys.mkdir(root + "/nested")
    _ := sys.write_text(root + "/nested/gamma.ddr", "todo again\nlast line\n")
    _ := sys.mkdir(root + "/.hidden")
    _ := sys.write_text(root + "/.hidden/secret.ddr", "TODO buried\n")
    .Ok(root)
}

fn run_search(pattern: string, extensions: []string, ignore_case: bool, max_matches: i32, root: string) -> []finn.Match {
    opts := finn.Options {
        pattern: pattern.clone(),
        roots: [root.clone()],
        extensions: extensions.clone(),
        ignore_case: ignore_case,
        max_matches: max_matches,
    }
    match finn.search(&opts) {
        .Ok(matches) => { matches },
        .Err(e) => { assert(e.len >= 0); assert(false); [] },
    }
}

@test fn search_matches_case_insensitively_across_files() {
    tree := make_tree()
    assert(tree.is_ok())
    match tree {
        .Ok(root) => {
            defer { _ := fs.remove_all(root) }
            matches := run_search("todo", ["ddr"], true, 100, root)
            assert(matches.len == 2)
            assert(matches[0].path == root + "/alpha.ddr")
            assert(matches[0].line == 2)
            assert(matches[1].path == root + "/nested/gamma.ddr")
            assert(matches[1].line == 1)
            assert(matches[1].text == "todo again")
        },
        .Err(e) => { assert(e.len >= 0); assert(false) },
    }
}

@test fn search_is_case_sensitive_without_flag() {
    tree := make_tree()
    assert(tree.is_ok())
    match tree {
        .Ok(root) => {
            defer { _ := fs.remove_all(root) }
            upper := run_search("TODO", [], false, 100, root)
            assert(upper.len == 1)
            assert(upper[0].path == root + "/alpha.ddr")

            lower := run_search("todo", [], false, 100, root)
            assert(lower.len == 1)
            assert(lower[0].path == root + "/nested/gamma.ddr")
        },
        .Err(e) => { assert(e.len >= 0); assert(false) },
    }
}

@test fn search_honors_extension_filter_and_skips_hidden() {
    tree := make_tree()
    assert(tree.is_ok())
    match tree {
        .Ok(root) => {
            defer { _ := fs.remove_all(root) }
            ddr_only := run_search("todo", ["ddr"], true, 100, root)
            assert(ddr_only.len == 2)

            txt_only := run_search("move", ["txt"], false, 100, root)
            assert(txt_only.len == 1)
            assert(txt_only[0].path == root + "/beta.txt")
        },
        .Err(e) => { assert(e.len >= 0); assert(false) },
    }
}

@test fn search_caps_total_matches() {
    tree := make_tree()
    assert(tree.is_ok())
    match tree {
        .Ok(root) => {
            defer { _ := fs.remove_all(root) }
            capped := run_search("todo", ["ddr"], true, 1, root)
            assert(capped.len == 1)
        },
        .Err(e) => { assert(e.len >= 0); assert(false) },
    }
}

@test fn search_reports_missing_roots() {
    opts := finn.Options {
        pattern: "x",
        roots: ["/nonexistent-finn-root"],
        extensions: [],
        ignore_case: false,
        max_matches: 10,
    }
    assert(finn.search(&opts).is_err())
}

@test fn line_matches_handles_empty_pattern_and_boundaries() {
    assert(finn.line_matches("anything", "", true))
    assert(finn.line_matches("anything", "", false))
    assert(finn.line_matches("find TODO here", "todo", true))
    assert(!finn.line_matches("find TODO here", "todo", false))
    assert(!finn.line_matches("ab", "abc", true))
    assert(finn.line_matches("AB", "ab", true))
}
