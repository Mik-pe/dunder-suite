import std.parse as parse
import std.text as text
import sys

import finn

fn usage() -> i32 {
    _ := sys.eprint("usage: finn [flags] PATTERN [PATH...]")
    _ := sys.eprint("  PATTERN  literal text to find (case-sensitive unless -i)")
    _ := sys.eprint("  PATH     file or directory to search (default: .)")
    _ := sys.eprint("flags: -i           ignore ASCII case")
    _ := sys.eprint("       -l           list matching paths only")
    _ := sys.eprint("       -t EXTS      comma-separated extensions, e.g. -t ddr,toml")
    _ := sys.eprint("       --max N      stop after N matches (default 1000)")
    _ := sys.eprint("hidden entries (dot-prefixed) and binary files are skipped")
    _ := sys.eprint("exit: 0 matches, 1 no matches, 2 error")
    return 2
}

fn main() -> i32 {
    mut ignore_case := false
    mut files_only := false
    mut max_matches := 1000
    mut extensions: []string = []
    mut roots: []string = []
    mut pattern := ""
    count := sys.arg_count()
    mut i := 1
    while i < count {
        a := sys.arg(i)
        if a == "-i" {
            ignore_case = true
        } else if a == "-l" {
            files_only = true
        } else if a == "-t" {
            if i + 1 >= count { _ := sys.eprint("finn: missing value after -t"); return 2 }
            i += 1
            for ext in text.split(sys.arg(i), ",") {
                trimmed := text.trim(ext)
                if trimmed.len > 0 { extensions.push(trimmed.clone()) }
            }
        } else if a == "--max" {
            if i + 1 >= count { _ := sys.eprint("finn: missing value after --max"); return 2 }
            i += 1
            n := parse.integer(sys.arg(i))
            if !n.ok || n.value < 1 { _ := sys.eprint("finn: --max must be positive"); return 2 }
            max_matches = i32(n.value)
        } else if text.starts_with(a, "-") && a.len > 1 {
            _ := sys.eprint("finn: unknown flag " + a)
            return 2
        } else if pattern.len == 0 {
            pattern = a.clone()
        } else {
            roots.push(a.clone())
        }
        i += 1
    }
    if pattern.len == 0 { return usage() }
    if roots.len == 0 { roots.push(".") }

    opts := finn.Options {
        pattern: pattern,
        roots: roots,
        extensions: extensions,
        ignore_case: ignore_case,
        max_matches: max_matches,
    }

    mut matches: []finn.Match = []
    mut failure := ""
    match finn.search(&opts) {
        .Ok(found) => { matches = found },
        .Err(e) => { failure = e },
    }
    if failure.len > 0 {
        _ := sys.eprint("finn: " + failure)
        return 2
    }
    if matches.len == 0 { return 1 }

    if files_only {
        mut previous := ""
        for m in matches {
            if m.path != previous {
                print(m.path)
                previous = m.path.clone()
            }
        }
        return 0
    }
    for m in matches {
        print(f"{m.path}:{m.line}: {m.text}")
    }
    return 0
}
